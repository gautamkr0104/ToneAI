# ---- Core ----
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ---- Database (required in production) ----
DATABASE_URL=postgres://toneai:toneai@localhost:5432/toneai
# Optional: used for rate-limit store / queues if configured
# REDIS_URL=redis://localhost:6379

# ---- App ----
# Public base URL of THIS backend (used to build the Instagram OAuth redirect)
APP_BASE_URL=http://localhost:3000
# Comma-separated allowed origins for the Android app / web dashboard
FRONTEND_ORIGINS=*

# ---- Auth secrets (REQUIRED in production — generate with: openssl rand -hex 48) ----
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# ---- Instagram / Meta (official APIs only; leave empty for mock mode) ----
# From developers.facebook.com > your app > Instagram > Basic settings
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=dev-verify-token
INSTAGRAM_GRAPH_VERSION=v21.0

# ---- AI (leave OPENAI_API_KEY empty to use the built-in mock AI) ----
AI_PROVIDER=openai
# OPENAI_API_KEY=
AI_FAST_MODEL=gpt-4o-mini
AI_REPLY_MODEL=gpt-4o-mini

# ---- Notifications ----
# noop | fcm (fcm requires FCM_SERVER_KEY; plug firebase-admin for production)
NOTIFICATION_PROVIDER=noop
# FCM_SERVER_KEY=

# ---- Cost control ----
DAILY_TOKEN_LIMIT=200000
DAILY_GENERATION_LIMIT=300

# ---- Logging ----
# NEVER enable in production — logs message content
LOG_MESSAGE_CONTENT=0
# Optional shared secret for the demo seeding script
# SEED_DEMO_TOKEN=
